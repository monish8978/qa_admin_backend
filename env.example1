# ─── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ─── Master DB ──────────────────────────────────────────────────────────────────
MASTER_DATABASE_URL=postgresql://postgres:sqladmin@postgres:5432/qa_master

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── JWT (min 32 chars each) ─────────────────────────────────────────────────────
JWT_SECRET=3OMLsZppV4lhxaCE1QFrMXWazInYJwZPGNjnBl1MOWAptmPuf3tvcPc2cYZdrxU4
JWT_EXPIRES_IN=15m
REFRESH_SECRET=vtI+lBYupxvmhuTxaJB1u3bJ6/BxiiOvXvmCnCx1IOKt1prSYasX9l5ootoDIzRX
REFRESH_EXPIRES_IN=30d

# ─── Encryption key — 64 hex chars = 32 bytes ─────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=2b6efb8fe83454be1208cf76ca5f1a241a0b3089af947f1bd87246207914aa83

# ─── Tenant DB provisioning ──────────────────────────────────────────────────────
TENANT_DATABASE_URL=postgresql://postgres:sqladmin@postgres:5432/postgres
TENANT_DB_HOST=postgres
TENANT_DB_PORT=5432
TENANT_DB_SUPERUSER=postgres
TENANT_DB_SUPERUSER_PASSWORD=sqladmin

# ─── Email ───────────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@qa-platform.local
SMTP_HOST=localhost
SMTP_PORT=1025
RUN_EMBEDDED_WORKERS=true
# SMTP_USER=
# SMTP_PASS=

# ─── Stripe (optional in dev) ────────────────────────────────────────────────────
